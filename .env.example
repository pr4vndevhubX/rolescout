# ============================================================
# LLM PROVIDERS — configure AT LEAST ONE (free options first!)
# All of them speak the OpenAI-compatible API; the app fails over
# between configured providers automatically (rate limits, outages).
# ============================================================

# Groq — FREE tier, fast Llama models. https://console.groq.com
# GROQ_API_KEY=gsk_...

# Google Gemini — FREE tier. https://aistudio.google.com/apikey
# GEMINI_API_KEY=AI...

# Ollama — 100% local and free. Install from https://ollama.com then:
#   ollama pull llama3.1
# OLLAMA_BASE_URL=http://localhost:11434/v1

# OpenRouter — many models, some free. https://openrouter.ai
# OPENROUTER_API_KEY=sk-or-...

# OpenAI — paid. https://platform.openai.com
# OPENAI_API_KEY=sk-...

# Failover order (first configured provider wins). Default shown.
# LLM_PROVIDER_PRIORITY=groq,gemini,openrouter,openai,ollama

# Per-provider model overrides (defaults are sensible; change freely):
# GROQ_FAST_MODEL=llama-3.1-8b-instant
# GROQ_SMART_MODEL=llama-3.3-70b-versatile
# GEMINI_FAST_MODEL=gemini-2.0-flash
# GEMINI_SMART_MODEL=gemini-2.5-flash

# ============================================================
# DATABASE — Neon serverless Postgres (free tier), with pgvector
# https://neon.tech -> project -> Connect (must include sslmode=require)
# ============================================================
DATABASE_URL=postgresql://USER:PASSWORD@ep-your-endpoint.region.aws.neon.tech/neondb?sslmode=require

# ============================================================
# AUTH — JWT signing secret (e.g. `openssl rand -hex 32`)
# ============================================================
JWT_SECRET=change-me-to-a-long-random-string
# JWT_EXPIRE_MINUTES=1440

# ============================================================
# JOB SOURCES — Remotive + Arbeitnow work with NO keys.
# Adzuna (optional, free tier) adds country-specific listings + salaries:
# https://developer.adzuna.com
# ============================================================
# ADZUNA_APP_ID=...
# ADZUNA_APP_KEY=...

# ============================================================
# NOTIFICATIONS — email digests/alerts (optional; unset = log only)
# Gmail: use an App Password (Google Account -> Security -> App passwords)
# ============================================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=you@gmail.com

# ============================================================
# THE ASSISTANT — autonomous daily cycle (optional, opt-in)
# Scouts your desired roles, matches, tailors near-misses, prepares
# applications, emails one digest. Per-user opt-in also required
# (daily digest toggle in preferences).
# ============================================================
# ASSISTANT_ENABLED=true
# ASSISTANT_DAILY_HOUR=6

# --- Optional: raw job-pool sync independent of the assistant ---
# JOB_SYNC_QUERIES=machine learning engineer;genai engineer
# JOB_SYNC_INTERVAL_HOURS=6
# JOB_SYNC_COUNTRY=in

# --- Optional: production hardening ---
# RATE_LIMIT_PER_MINUTE=60
# CORS_ORIGINS=https://your-frontend.com
